{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "pack_id": {
      "const": "SWORDS_EVOLUTION_FUSION_1000"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "unique_design_count": {
      "const": 1000
    },
    "archetypes": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object"
      }
    },
    "paths": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1000,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SW_[A-Z]+_[A-Z]+_T[1-5]$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "archetype_id": {
            "type": "string",
            "minLength": 1
          },
          "path_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "neutral",
              "element",
              "fusion"
            ]
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "fusion_parent_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 2,
            "uniqueItems": true
          },
          "png_256": {
            "type": "string",
            "minLength": 1
          },
          "png_512": {
            "type": "string",
            "minLength": 1
          },
          "png_1024": {
            "type": "string",
            "minLength": 1
          },
          "unity_asset_path": {
            "type": "string",
            "minLength": 1
          },
          "unreal_object_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "display_name",
          "archetype_id",
          "path_id",
          "kind",
          "tier",
          "fusion_parent_paths",
          "png_256",
          "png_512",
          "png_1024",
          "unity_asset_path",
          "unreal_object_path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "pack_id",
    "title",
    "unique_design_count",
    "archetypes",
    "paths",
    "assets"
  ],
  "additionalProperties": false
}
