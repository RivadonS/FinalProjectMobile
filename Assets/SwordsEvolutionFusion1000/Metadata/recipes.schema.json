{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "pack_id": {
      "const": "SWORDS_EVOLUTION_FUSION_1000"
    },
    "recipe_policy": {
      "type": "object"
    },
    "recipes": {
      "type": "array",
      "minItems": 990,
      "maxItems": 990,
      "items": {
        "type": "object",
        "properties": {
          "recipe_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "upgrade",
              "elemental_transform",
              "fusion"
            ]
          },
          "archetype_id": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "item_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "item_id",
                "quantity"
              ],
              "additionalProperties": false
            }
          },
          "output_item_id": {
            "type": "string",
            "minLength": 1
          },
          "output_quantity": {
            "type": "integer",
            "minimum": 1
          },
          "resource_costs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "resource_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "resource_id",
                "quantity"
              ],
              "additionalProperties": false
            }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "minimum_player_level"
                },
                "value": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "recipe_id",
          "kind",
          "archetype_id",
          "inputs",
          "output_item_id",
          "output_quantity",
          "resource_costs",
          "requirements"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "pack_id",
    "recipe_policy",
    "recipes"
  ],
  "additionalProperties": false
}
